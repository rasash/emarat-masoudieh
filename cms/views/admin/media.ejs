<%- include("_head", { title: "کتابخانه رسانه", actions: "" }) %>
<form class="panel upload-box" method="post" action="/admin/media" enctype="multipart/form-data">
  <h2>آپلود عکس جدید</h2>
  <p class="hint">پس از آپلود، نسخه WebP در چند اندازه ساخته می‌شود.</p>
  <input type="file" name="files" accept="image/*" multiple required />
  <label>متن جایگزین پیش‌فرض
    <input name="alt" placeholder="توضیح کوتاه عکس" />
  </label>
  <label>دسته
    <select name="category">
      <option value="">بدون دسته</option>
      <option>نما</option>
      <option>حیاط</option>
      <option>فضای داخلی</option>
      <option>تزئینات</option>
      <option>اسناد تاریخی</option>
    </select>
  </label>
  <button class="btn" type="submit">آپلود</button>
</form>
<div class="media-grid">
  <% items.forEach(function (item) { %>
    <article class="media-card">
      <img src="<%= mediaSrc ? mediaSrc(item) : mediaUrl(item) %>" alt="<%= item.alt %>" />
      <form method="post" action="/admin/media/<%= item.id %>">
        <input name="alt" value="<%= item.alt %>" placeholder="متن جایگزین" />
        <input name="category" value="<%= item.category || "" %>" placeholder="دسته: نما / تزئینات / ..." />
        <button class="btn ghost" type="submit">ذخیره توضیح</button>
      </form>
      <form method="post" action="/admin/media/<%= item.id %>/replace" enctype="multipart/form-data">
        <input type="file" name="file" accept="image/*" required />
        <button class="btn ghost" type="submit">جایگزینی عکس</button>
      </form>
      <button type="button" class="btn ghost" data-crop-open="<%= mediaSrc ? mediaSrc(item) : mediaUrl(item) %>">برش</button>
      <form method="post" action="/admin/media/<%= item.id %>/delete" onsubmit="return confirm('حذف این عکس؟');">
        <button class="btn danger" type="submit">حذف</button>
      </form>
    </article>
  <% }) %>
</div>
<%- include("_foot") %>
