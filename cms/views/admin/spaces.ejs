<%- include("_head", { title: "نقشه فضاها", actions: "" }) %>
<p class="hint">نقطه‌ها روی عکس کامل حیاط‌اند. چپ = ۰ و راست = ۱۰۰؛ بالا = ۰ و پایین = ۱۰۰. سفره‌خانه روی جناح ستون‌دار راست است، نه وسط سنگفرش.</p>
<% items.forEach(function (item) { %>
  <form class="panel" method="post" action="/admin/spaces/<%= item.id %>">
    <h2><%= item.title %></h2>
    <div class="grid2">
      <label>عنوان <input name="title" value="<%= item.title %>" /></label>
      <label>دوره <input name="era" value="<%= item.era || "" %>" /></label>
      <label>کاربری <input name="role" value="<%= item.role || "" %>" /></label>
      <label>متن <textarea name="body" rows="4"><%= item.body %></textarea></label>
      <label>X درصد <input name="x" type="number" min="0" max="100" step="0.5" value="<%= item.x %>" /></label>
      <label>Y درصد <input name="y" type="number" min="0" max="100" step="0.5" value="<%= item.y %>" /></label>
    </div>
    <div class="hero-pick">
      <input type="hidden" name="media_id" data-k="media_id" value="<%= item.media_id || "" %>" />
      <div class="pick-preview"><% if (item.media) { %><img src="<%= mediaUrl(item.media) %>" alt="" /><% } else { %><em>عکس</em><% } %></div>
      <button type="button" class="btn ghost" data-open-picker="space-<%= item.id %>">تغییر عکس</button>
    </div>
    <button class="btn" type="submit">ذخیره فضا</button>
  </form>
<% }) %>
<%- include("_foot") %>
